{% layout 'logged-in-layout.liquid' %}
{% block view %}
  <table>
    <thead>
      <tr>
        <th>{{ 'tableHeader_firstName' | t }}</th>
        <th>{{ 'tableHeader_lastName' | t }}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {% for mp in mps %}
        <tr>
          <td>{{ mp.firstName }}</td>
          <td>{{ mp.lastName }}</td>
          <td>
            <form action="{{ action }}" method="post">
              <input type="hidden" name="personId" value="{{ mp.id }}"
              /><button>{{ 'table_newFeedbackButton' | t }}</button>
            </form>
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
